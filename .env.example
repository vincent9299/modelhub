# ============================================
# modelhub 环境变量模板
# 用法: cp .env.example .env && 填入真实值
# 注意: .env 已被 gitignore, 永不入库
#
# 端点与 key 都是可配置的: 改这里的值, 重启网关即生效;
# 通配路由会自动把上游端点上的全部模型带进 /v1/models
# ============================================

# ---- 上游: OpenRouter（通配路由, 全部模型自动识别; 走静态出口）----
OPENROUTER_API_KEY=sk-or-v1-xxxx
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# ---- 上游: Galaxy 专线（OpenAI 兼容; 自动发现 + 固定别名）----
GALAXY_API_KEY=sk-xxxx
GALAXY_API_BASE=https://token.ai-galaxy.com/v1

# ---- 上游: 本地 OpenAI 兼容端点（vLLM 等; 通配路由, 全部模型自动识别）----
VLLM_API_BASE=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

# ---- 网关监听 ----
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4000

# ---- 静态代理本地端口（与 static_proxy/config.yaml 保持一致）----
PROXY_MIXED_PORT=7891
PROXY_API_PORT=9091
