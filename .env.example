# ============================================
# modelhub 环境变量模板
# 用法: cp .env.example .env && 填入真实值
# 注意: .env 已被 gitignore, 永不入库
# ============================================

# ---- 必填: 上游 API Key ----
OPENROUTER_API_KEY=sk-or-v1-xxxx
GALAXY_API_KEY=sk-xxxx

# ---- 可选: 端点地址（默认值见下, 按需改）----
VLLM_API_BASE=http://localhost:8000/v1
GALAXY_API_BASE=https://token.ai-galaxy.com/v1
VLLM_API_KEY=EMPTY

# ---- 可选: 网关监听 ----
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4000

# ---- 可选: 静态代理本地端口（与 static_proxy/config.yaml 保持一致）----
PROXY_MIXED_PORT=7891
PROXY_API_PORT=9091
